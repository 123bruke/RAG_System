# Copy this file to .env and fill in your key:   cp .env.example .env
# NEVER commit .env (it is listed in .gitignore).

# LLM provider: "gemini" (Google AI Studio key, starts with AIza...) or "openai"
LLM_PROVIDER=gemini
GOOGLE_API_KEY=
OPENAI_API_KEY=

# Leave blank to use the provider default (gemini-2.5-flash / gpt-4o-mini)
LLM_MODEL=
LLM_TEMPERATURE=0.0

# Storage
CHROMA_PATH=./chroma_db
DOCUMENTS_DIR=./data/documents

# Chunking
CHUNK_SIZE=500
CHUNK_OVERLAP=100

# Retrieval
TOP_K_VECTOR=10
TOP_K_BM25=10
TOP_K_HYBRID=10
TOP_K_RERANK=5
RRF_K=60

# Models
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

LOG_LEVEL=INFO
